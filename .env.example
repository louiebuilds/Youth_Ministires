# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only privileged configuration
# Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Communications email defaults to synthetic. These values are server-only.
COMMUNICATIONS_EMAIL_MODE=synthetic
RESEND_API_KEY=
COMMUNICATIONS_FROM_EMAIL=
COMMUNICATIONS_FROM_NAME=Youth Ministries
COMMUNICATIONS_REPLY_TO_EMAIL=
# Comma-separated beta recipients. Empty means no live email can be sent.
COMMUNICATIONS_EMAIL_ALLOWLIST=
